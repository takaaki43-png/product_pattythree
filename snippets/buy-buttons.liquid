  {%- if product.tags contains '予約商品0802' -%}

<script>
fetch('http://worldtimeapi.org/api/timezone/Asia/Tokyo')
  .then(response => response.json())
  .then(data => {
    var currentTime = new Date(data.datetime);
    var releaseTime = new Date('2023-08-02T15:00:00'); // 例: 予約販売開始時刻

    var submitButtonSpan = document.querySelector('.product-form__submit span');
    var submitButton = submitButtonSpan ? submitButtonSpan.closest('.product-form__submit') : null;

    if (submitButton) {
      if (currentTime < releaseTime) {
        submitButtonSpan.textContent = 'まもなく発売';
        submitButton.disabled = true;
      } else {
        submitButtonSpan.textContent = '予約購入';
        submitButton.disabled = false; // ボタンのdisabledを解除
      }
    }
  })
  .catch(error => {
    console.error('An error occurred:', error);
  });



</script>
