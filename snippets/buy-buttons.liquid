{% comment %}
  Renders product buy-buttons.
  Accepts:
  - product: {Object} product object.
  - block: {Object} passing the block information.
  - product_form_id: {String} product form id.
  - section_id: {String} id of section to which this snippet belongs.
  - show_pickup_availability: {Boolean} for the pickup availability. If true the pickup availability is rendered, false - not rendered (optional).

  Usage:
  {% render 'buy-buttons', block: block, product: product, product_form_id: product_form_id, section_id: section.id, show_pickup_availability: true %}
{% endcomment %}
<div {{ block.shopify_attributes }}>
  {%- if product != blank -%}
    {%- liquid
      assign gift_card_recipient_feature_active = false
      if block.settings.show_gift_card_recipient and product.gift_card?
        assign gift_card_recipient_feature_active = true
      endif

      assign show_dynamic_checkout = false
      if block.settings.show_dynamic_checkout and gift_card_recipient_feature_active == false
        assign show_dynamic_checkout = true
      endif
    -%}
<!-- MultiVariants app code start [ https://apps.shopify.com/multivariants ] -->
	<div id="MULTIVARIANTS_APP_SECTION_PLACE"></div><script type="text/javascript" src="https://sapp.multivariants.com/gate/out/sys/js/init.js?shop=pattethree.myshopify.com&product_id={{product.id}}&locale={{shop.locale}}"></script>
<!-- MultiVariants App code end -->
{%-comment -%}
バリエーション有無による処理
{%-endcomment -%}

{% if product.variants.size > 1 %}
  <!-- バリエーション商品がある場合の処理 -->
     {% assign product_variation = true %}

{% else %}
  <!-- バリエーション商品がない場合の処理 -->
     {% assign product_variation = false %}
{% endif %}

{%-comment -%}
同時購入不可制御
  - エラー表示はbuy_errorがtrueの場合
  - カートの中のタグをチェック

{%-endcomment -%}
{%-comment -%}
同時購入不可制御（差し替え版）
  - エラー表示はbuy_errorがtrueの場合
  - カート内の「同時購入不可○」グループを確認
  - 現在の商品が同じグループなら購入可
  - 違うグループ、または通常商品との混在時は購入不可
  - 「特典商品」は従来通り通常商品扱いしない
{%-endcomment -%}

{% assign buy_error = false %}
{% assign cart_restrict_group = '' %}
{% assign current_restrict_group = '' %}
{% assign has_normal_item_in_cart = false %}

{%- comment -%}
  カート内チェック
{%- endcomment -%}
{% for item in cart.items %}
  {% assign item_restrict_group = '' %}

  {% for item_tag in item.product.tags %}
    {% if item_tag contains '同時購入不可' %}
      {% assign item_restrict_group = item_tag | remove: '同時購入不可' | strip %}
      {% break %}
    {% endif %}
  {% endfor %}

  {% if item_restrict_group != '' %}
    {% if cart_restrict_group == '' %}
      {% assign cart_restrict_group = item_restrict_group %}
    {% endif %}
  {% elsif item.product.tags contains '特典商品' %}
  {% else %}
    {% assign has_normal_item_in_cart = true %}
  {% endif %}
{% endfor %}

{%- comment -%}
  現在の商品チェック
{%- endcomment -%}
{% for tag in product.tags %}
  {% if tag contains '同時購入不可' %}
    {% assign current_restrict_group = tag | remove: '同時購入不可' | strip %}
    {% break %}
  {% endif %}
{% endfor %}

{%- comment -%}
  判定
{%- endcomment -%}
{% if current_restrict_group != '' %}
  {%- comment -%}
    今見ている商品が「同時購入不可商品」の場合
  {%- endcomment -%}

  {% if has_normal_item_in_cart %}
    {% assign buy_error = true %}
  {% elsif cart_restrict_group != '' and cart_restrict_group != current_restrict_group %}
    {% assign buy_error = true %}
  {% endif %}

{% else %}
  {%- comment -%}
    今見ている商品が通常商品の場合
    カート内に同時購入不可商品があればNG
  {%- endcomment -%}

  {% if cart_restrict_group != '' %}
    {% assign buy_error = true %}
  {% endif %}
{% endif %}

