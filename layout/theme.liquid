<script>
window.addEventListener('load', function() {
    setInterval(function() {
        var subtotalElement = document.querySelector('.totals__subtotal-value');
        var checkoutButton = document.getElementById('checkout');  // チェックアウトボタンのIDを正しく指定してください。
        if (subtotalElement && subtotalElement.textContent.trim() == '¥0') {
            if (checkoutButton) {
                checkoutButton.style.display = 'none';  // チェックアウトボタンを非表示にする
            }

        } else {
            if (checkoutButton) {
                checkoutButton.style.display = 'block';  // チェックアウトボタンを表示に戻す
            }

        }
    }, 1000);  // 1秒ごとに実行
});
</script>
