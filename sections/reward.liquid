    {
      "name": "Reward"
    }
  ]
}
{% endschema %}

{% javascript %}

  
    document.querySelectorAll(".openModal").forEach(button => {
      button.addEventListener("click", function(event) {
        event.preventDefault();
        document.querySelector(".modal").style.display = "block";
      });
    });
    
    document.querySelector(".closeModal").addEventListener("click", function() {
      document.querySelector(".modal").style.display = "none";
    });
    
    window.addEventListener("click", function(event) {
      if (event.target.classList.contains("modal")) {
        event.target.style.display = "none";
      }
    });
  if (!window.submitExchange) {
    window.submitExchange = async (variantId, element, productId, requiresShipping, rewardPoint) => {
      if (!variantId) return;

      // Disable all exchange buttons
      document.querySelectorAll('[id^="exchange-button-"]').forEach((button) => {
        button.disabled = true;
      });

      const url = '/apps/pointapi/exchange/shopifyproduct';
      const params = {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
        },
        body: JSON.stringify({
          variant_id: variantId,
          product_id: productId,
          requires_shipping: requiresShipping === 'true',
          reward_point: parseInt(rewardPoint, 10),
        }),
      };

      try {
        const response = await fetch(url, params);
        const data = await response.json();
        if (data.status === 'success' && data.data.checkout_url) {
          document.location = data.data.checkout_url;
        } else {
          // Hide all error messages first
          document.querySelectorAll(`[id^="error-"][id$="-${productId}"]`).forEach((el) => {
            el.style.display = 'none';
          });

          // Show specific error message based on error code
          if (data.data.error_code === 'exchange_limit_error') {
            document.getElementById(`error-limit-${productId}`).style.display = 'block';
          } else if (data.data.error_code === 'exchange_point_error') {
            document.getElementById(`error-point-${productId}`).style.display = 'block';
          } else if (data.data.error_code === 'exchange_date_range_error') {
            document.getElementById(`error-date-range-limit-${productId}`).style.display = 'block';
          }

          // Re-enable exchange button
          document.querySelectorAll('[id^="exchange-button-"]').forEach((button) => {
            button.disabled = false;
          });
        }
      } catch (error) {
        console.error('Error:', error);
        // On error, re-enable all exchange buttons
        document.querySelectorAll('[id^="exchange-button-"]').forEach((button) => {
          button.disabled = false;
        });
      }
    };
  }

  if (!customElements.get('reward-variant-selects')) {
    class RewardVariantSelects extends HTMLElement {
      constructor() {
        super();
        this.setupEventListeners();
        this.productData = JSON.parse(this.querySelector('script[type="application/json"]').textContent);
        this.productId = this.productData.id;
        this.requiresShipping = this.dataset.requiresShipping;
        this.rewardPoint = this.dataset.rewardPoint;
        this.updateButtonState();
      }

      setupEventListeners() {
        this.querySelectorAll('select').forEach((select) => {
          select.addEventListener('change', this.onVariantChange.bind(this));
        });
      }

      onVariantChange(event) {
        if (!event.target.matches('select')) return;
        this.getSelectedOptions();
        this.getSelectedVariant();
        this.updateVariantInput();
        this.updateVariantImage();
        this.updateButtonState();
      }

      getSelectedOptions() {
        this.options = Array.from(this.querySelectorAll('select'), (select) => select.value);
      }

      getSelectedVariant() {
        if (!this.productData || !this.productData.variants) return;

        this.currentVariant = this.productData.variants.find((variant) => {
          return !variant.options
            .map((option, index) => {
              return this.options[index] === option;
            })
            .includes(false);
        });
      }

      updateButtonState() {
        const button = this.querySelector('button');
        if (!button) return;

        let isAvailable = false;
        let variantId = null;

        if (this.productData.has_only_default_variant) {
          isAvailable = this.productData.available;
          variantId = this.productData.variants[0].id;
        } else if (this.currentVariant) {
          isAvailable = this.currentVariant.available;
          variantId = this.currentVariant.id;
        } else {
          isAvailable = this.productData.variants.some((variant) => variant.available);
          variantId = this.productData.variants.find((v) => v.available)?.id;
        }

        if (!isAvailable) {
          button.classList.add('disabled');
          button.setAttribute('disabled', '');
          button.textContent = '在庫切れ';
        } else {
          button.classList.remove('disabled');
          button.removeAttribute('disabled');
          button.textContent = '交換する';
          button.setAttribute('data-variant-id', variantId);
          button.onclick = () =>
            submitExchange(variantId, button, this.productId, this.requiresShipping, this.rewardPoint);
        }

        // エラーメッセージの表示を更新
        const stockError = document.querySelector(`#error-stock-${this.productId}`);
        if (stockError) {
          stockError.style.display = !isAvailable ? 'block' : 'none';
        }
      }

      updateVariantInput() {
        const input = this.querySelector('input[name="id"]');
        if (input && this.currentVariant) {
          input.value = this.currentVariant.id;
        }
      }

      updateVariantImage() {
        if (!this.currentVariant || !this.currentVariant.featured_image) return;

        const imageWrapper = document.querySelector(`.reward__image-wrapper[data-product-id="${this.productId}"]`);
        if (!imageWrapper) return;

        const image = imageWrapper.querySelector('.reward__image');
        if (!image) return;

        const newImage = this.currentVariant.featured_image;
        image.src = newImage.src;
        image.alt = newImage.alt || '';
      }
    }

    customElements.define('reward-variant-selects', RewardVariantSelects);
  }

  
{% endjavascript %}
