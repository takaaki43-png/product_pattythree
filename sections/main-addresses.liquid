<script>
  window.onload = () => {
    typeof CustomerAddresses !== 'undefined' && new CustomerAddresses();
  };
  document.addEventListener("DOMContentLoaded", () => {
    const setDefaultToggles = document.querySelectorAll('.js-address-default-trigger');
    console.log('section load');
    for( toggle of setDefaultToggles){
      toggle.addEventListener('change', (e) => {
        const btn = e.target;
        const addressForm = btn.closest('.o_customers__address').querySelector('form');

        addressForm.submit();
      });
    }
  });
</script>

