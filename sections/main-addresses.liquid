{{ 'customer.css' | asset_url | stylesheet_tag }}

<script src="{{ 'customer.js' | asset_url }}" defer></script>

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }
  .is-default .o_customers__address__buttons button:nth-child(2) {
    display: none;
  }
  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

{%- paginate customer.addresses by 5 -%}
  <div class="customer o_customers addresses section-{{ section.id }}-padding" data-customer-addresses>
    <svg style="display: none">
      <symbol id="icon-caret" viewBox="0 0 10 6">
        <path fill-rule="evenodd" clip-rule="evenodd" d="M9.354.646a.5.5 0 00-.708 0L5 4.293 1.354.646a.5.5 0 00-.708.708l4 4a.5.5 0 00.708 0l4-4a.5.5 0 000-.708z" fill="currentColor">
      </symbol>
    </svg>
    <h1 class="o_customers__title">お届け先住所</h1>
    

    <ul role="list">
      {%- for address in customer.addresses -%}
        <li class="o_customers__address{% if address == customer.default_address %} is-default{% endif %}" data-address>
          {%- if address == customer.default_address -%}
            <h2 class="o_customers__address__title">{{ 'customer.addresses.default' | t }}</h2>
          {%- endif -%}
          <table class="o_customers__address__table{% if address == customer.default_address %} o_customers__address__table--default{%endif %}">
            <tbody>
              {% unless address.name == null  %}
              <tr>
                <th>{{ 'customer.addresses.reg_name' | t }}</th>
                <td>{{ address.name }}</td>
              </tr>
              {% endunless %}
              <tr>
                <th>{{ 'customer.addresses.zip' | t }}</th>
                <td>〒{{ address.zip }}</td>
              </tr>
              <tr>
                <th>{{ 'customer.addresses.title' | t }}</th>
                <td>{{ address.province }}{{ address.city }}{{ address.address1 }}{{ address.address2 }}</td>
              </tr>
              {% unless address.phone == null %}
              <tr>
                <th>{{ 'customer.addresses.phone' | t }}</th>
                <td>{{ address.phone }}</td>
              </tr>
              {% endunless %}
            </tbody>
          </table>
          {%- unless address == customer.default_address -%}
            <div class="o_customers__address__set-default">
              <input 
                type="checkbox" 
                class="js-address-default-trigger"
                id="address_default_address_{{ address.id }}" 
              >
              <label for="address_default_address_{{ address.id }}">標準のお届け先として設定する</label>
            </div>
          {%- endunless -%}
          <div class="o_customers__address__buttons">
            <button
              type="button"
              id="EditFormButton_{{ address.id }}"
              aria-label="{{ 'customer.addresses.edit_address' | t }} {{ forloop.index }}"
              aria-controls="EditAddress_{{ address.id }}"
              aria-expanded="false"
              data-address-id="{{ address.id }}"
            >
              {{ 'customer.addresses.edit' | t }}
            </button>
            <button
              type="button"
              aria-label="{{ 'customer.addresses.delete' | t }} {{ forloop.index }}"
              data-target="{{ address.url }}"
              data-confirm-message="{{ 'customer.addresses.delete_confirm' | t }}"
            >
              {{ 'customer.addresses.delete' | t }}
            </button>
          </div>
          <div 
            id="EditAddress_{{ address.id }}" 
            class="o_customers__address__edit"
            aria-labelledby="EditFormButton_{{ address.id }}"
            aria-expanded="false"
          >
            <h2 class="u_textCenter">{{ 'customer.addresses.edit_address' | t }}</h2>
            {%- form 'customer_address', address -%}
              <input 
                type="hidden" 
                name="address[default]" 
                value="1"
              >
              <div class="field o_customers__input-field">
                <input
                  type="text"
                  id="AddressLastName_{{ form.id }}"
                  name="address[last_name]"
                  value="{{ form.last_name }}"
                  autocomplete="family-name"
                  placeholder="{{ 'customer.addresses.last_name' | t }}"
                >
                <label for="AddressLastName_{{ form.id }}">{{ 'customer.addresses.last_name' | t }}</label>
              </div>
              <div class="field o_customers__input-field">
                <input
                  type="text"
                  id="AddressFirstName_{{ form.id }}"
                  name="address[first_name]"
                  value="{{ form.first_name }}"
                  autocomplete="given-name"
                  placeholder="{{ 'customer.addresses.first_name' | t }}"
                >
                <label for="AddressFirstName_{{ form.id }}">{{ 'customer.addresses.first_name' | t }}</label>
              </div>
              
              {%- if false %}
                <div class="field">
                  <input
                    type="text"
                    id="AddressCompany_{{ form.id }}"
                    name="address[company]"
                    value="{{ form.company }}"
                    autocomplete="organization"
                    placeholder="{{ 'customer.addresses.company' | t }}"
                  >
                  <label for="AddressCompany_{{ form.id }}">{{ 'customer.addresses.company' | t }}</label>
                </div>
              {%- endif -%}
              <div class="field o_customers__input-field">
                <input
                  type="text"
                  id="AddressZip_{{ form.id }}"
                  name="address[zip]"
                  value="{{ form.zip }}"
                  autocapitalize="characters"
                  autocomplete="postal-code"
                  placeholder="{{ 'customer.addresses.zip' | t }}"
                >
                <label for="AddressZip_{{ form.id }}">{{ 'customer.addresses.zip' | t }}</label>
              </div>
{% assign province_jp = "愛知県,秋田県,青森県,千葉県,愛媛県,福井県,福岡県,福島県,岐阜県,群馬県,広島県,北海道,兵庫県,茨城県,石川県,岩手県,香川県,山梨県,山口県,高知県,熊本県,京都府,三重県,山形県,宮崎県,長野県,長崎県,奈良県,新潟県,大分県,岡山県,沖縄県,大阪府,佐賀県,埼玉県,滋賀県,島根県,静岡県,栃木県,徳島県,鳥取県,富山県,東京都,宮城県,和歌山県,神奈川県,鹿児島県" | split: "," %}
{% assign province_en = "Aichi,Akita,Aomori,Chiba,Ehime,Fukui,Fukuoka,Fukushima,Gifu,Gunma,Hiroshima,Hokkaidō,Hyōgo,Ibaraki,Ishikawa,Iwate,Kagawa,Yamanashi,Yamaguchi,Kōchi,Kumamoto,Kyōto,Mie,Yamagata,Miyazaki,Nagano,Nagasaki,Nara,Niigata,Ōita,Okayama,Okinawa,Ōsaka,Saga,Saitama,Shiga,Shimane,Shizuoka,Tochigi,Tokushima,Tottori,Toyama,Tōkyō,Miyagi,Wakayama,Kanagawa,Kagoshima" | split: "," %}
{% assign num = 0 %}
{% for p in province_jp %}
{% if p == address.province %}
{% assign province = province_en[num] %}
{% break %}
{% endif %}
{% assign num = num | plus:1 %}
{% endfor %}
              
              <div id="AddressProvinceContainer_{{ form.id }}" class="field o_customers__input-field">
                <label for="AddressProvince_{{ form.id }}">
                  {{ 'customer.addresses.province' | t }}
                </label>

<div class="select">
{% assign provinces = "北海道,青森県,岩手県,宮城県,秋田県,山形県,福島県,茨城県,栃木県,群馬県,埼玉県,千葉県,東京都,神奈川県,新潟県,富山県,石川県,福井県,山梨県,長野県,岐阜県,静岡県,愛知県,三重県,滋賀県,京都府,大阪府,兵庫県,奈良県,和歌山県,鳥取県,島根県,岡山県,広島県,山口県,徳島県,香川県,愛媛県,高知県,福岡県,佐賀県,長崎県,熊本県,大分県,宮崎県,鹿児島県,沖縄県" | split: "," %}

<select id="AddressProvince_{{ form.id }}" name="address[province]" data-default="{{ form.province }}" autocomplete="address-level1">
  {% for province in provinces %}
    <option value="{{ province }}"{% if form.province == province%} selected{% endif %}>{{ province }}</option>
  {% endfor %}
</select>

                  <span class="cf-down-arrow"></span>
                </div>
              </div>
              <div class="field o_customers__input-field">
                <input
                  type="text"
                  id="AddressCity_{{ form.id }}"
                  name="address[city]"
                  value="{{ form.city }}"
                  autocomplete="address-level2"
                  placeholder="{{ 'customer.addresses.city' | t }}"
                >
                <label for="AddressCity_{{ form.id }}">{{ 'customer.addresses.city' | t }}</label>
              </div>
              <div class="field o_customers__input-field">
                <input
                  type="text"
                  id="AddressAddress1_{{ form.id }}"
                  name="address[address1]"
                  value="{{ form.address1 }}"
                  autocomplete="address-line1"
                  placeholder="{{ 'customer.addresses.address1' | t }}"
                >
                <label for="AddressAddress1_{{ form.id }}">{{ 'customer.addresses.address1' | t }}</label>
              </div>
              <div class="field o_customers__input-field">
                <input
                  type="text"
                  id="AddressAddress2_{{ form.id }}"
                  name="address[address2]"
                  value="{{ form.address2 }}"
                  autocomplete="address-line2"
                  placeholder="{{ 'customer.addresses.address2' | t }}"
                >
                <label for="AddressAddress2_{{ form.id }}">{{ 'customer.addresses.address2' | t }}</label>
              </div>
              
              <div class="field o_customers__input-field">
                <input
                  type="tel"
                  id="AddressPhone_{{ form.id }}"
                  name="address[phone]"
                  value="{{ form.phone }}"
                  autocomplete="tel"
                  placeholder="{{ 'customer.addresses.phone' | t }}"
                >
                <label for="AddressPhone_{{ form.id }}">{{ 'customer.addresses.phone' | t }}</label>
              </div>
              <div class="add_btn_alert u_textCenter u_mt30sp u_mt50">
                <button>{{ 'customer.addresses.update' | t }}</button>
                <button type="reset">{{ 'customer.addresses.cancel' | t }}</button>
              </div>
             <p class="u_fz12pc u_mt20 u_textLeft">
              ※住所は都道府県以下、44文字以内でご入力ください。<br>
              ※マイページの住所は、最後に購入された際の配送先住所が自動的に反映されております。<br>
              ※ご注文完了後に情報を変更された場合、商品のお届けは変更前（ご注文時）の住所となりますので、ご注意ください。<br>
              ※ご注文に関するご案内メールは購入時のメールアドレス宛に届きます。<br>
              注文済み商品のご案内メールも変更したい場合は、お手数ですがお問い合わせよりご連絡をお願いいたします。 
              </p>
            {%- endform -%}
          </div>
        </li>
      {%- endfor -%}
    </ul>

    {%- if paginate.pages > 1 -%}
      {%- if paginate.parts.size > 0 -%}
        <nav class="pagination" role="navigation" aria-label="{{ 'general.pagination.label' | t }}">
          <ul role="list">
            {%- if paginate.previous -%}
              <li>
                <a href="{{ paginate.previous.url }}" aria-label="{{ 'general.pagination.previous' | t }}">
                  <svg aria-hidden="true" focusable="false" viewBox="0 0 10 6">
                    <path fill-rule="evenodd" clip-rule="evenodd" d="M9.354.646a.5.5 0 00-.708 0L5 4.293 1.354.646a.5.5 0 00-.708.708l4 4a.5.5 0 00.708 0l4-4a.5.5 0 000-.708z" fill="currentColor">
                  </svg>
                </a>
              </li>
            {%- endif -%}

            {%- for part in paginate.parts -%}
              <li>
                {%- if part.is_link -%}
                  <a href="{{ part.url }}" aria-label="{{ 'general.pagination.page' | t: number: part.title }}">
                    {{- part.title -}}
                  </a>
                {%- else -%}
                  {%- if part.title == paginate.current_page -%}
                    <span aria-current="page" aria-label="{{ 'general.pagination.page' | t: number: part.title }}">
                      {{- part.title -}}
                    </span>
                  {%- else -%}
                    <span>{{ part.title }}</span>
                  {%- endif -%}
                {%- endif -%}
              </li>
            {%- endfor -%}

            {%- if paginate.next -%}
              <li>
                <a href="{{ paginate.next.url }}" aria-label="{{ 'general.pagination.next' | t }}">
                  <svg aria-hidden="true" focusable="false" viewBox="0 0 10 6">
                    <path fill-rule="evenodd" clip-rule="evenodd" d="M9.354.646a.5.5 0 00-.708 0L5 4.293 1.354.646a.5.5 0 00-.708.708l4 4a.5.5 0 00.708 0l4-4a.5.5 0 000-.708z" fill="currentColor">
                  </svg>
                </a>
              </li>
            {%- endif -%}
          </ul>
        </nav>
      {%- endif -%}
    {%- endif -%}    
    <div data-address>
      <button
        type="button"
        aria-expanded="false"
        aria-controls="AddAddress"
        class="o_customers__btn o_customers__btn--big a_button a_button--rounded u_mt130 u_mt50sp"
        style="min-width:340px"
      >
        {{ 'customer.addresses.add_new' | t }}
      </button>
      <div id="AddAddress">
        <h2 id="AddressNewHeading" class="u_mt60 u_textCenter">{{ 'customer.addresses.add_new' | t }}</h2>
        {%- form 'customer_address', customer.new_address, aria-labelledBy: 'AddressNewHeading' -%}
          <div class="field o_customers__input-field">
            <input
              type="text"
              id="AddressLastName_{{ form.id }}"
              name="address[last_name]"
              value="{{ form.last_name }}"
              autocomplete="family-name"
              placeholder="{{ 'customer.addresses.last_name' | t }}"
            >
            <label for="AddressLastName_{{ form.id }}">{{ 'customer.addresses.last_name' | t }}</label>
          </div>
          <div class="field o_customers__input-field">
            <input
              type="text"
              id="AddressFirstNameNew"
              name="address[first_name]"
              value="{{ form.first_name }}"
              autocomplete="given-name"
              placeholder="{{ 'customer.addresses.first_name' | t }}"
            >
            <label for="AddressFirstNameNew">{{ 'customer.addresses.first_name' | t }}</label>
          </div>
          {%- if false %}
            <div class="field o_customers__input-field">
              <input
                type="text"
                id="AddressCompanyNew"
                name="address[company]"
                value="{{ form.company }}"
                autocomplete="organization"
                placeholder="{{ 'customer.addresses.company' | t }}"
              >
              <label for="AddressCompanyNew">{{ 'customer.addresses.company' | t }}</label>
            </div>
          {%- endif -%}
          <div class="field o_customers__input-field">
            <input
              type="text"
              id="AddressZipNew"
              name="address[zip]"
              value="{{ form.zip }}"
              autocapitalize="characters"
              autocomplete="postal-code"
              placeholder="{{ 'customer.addresses.zip' | t }}"
            >
            <label for="AddressZipNew">{{ 'customer.addresses.zip' | t }}</label>
          </div>
          <div id="AddressProvinceContainerNew" class="field o_customers__input-field">
            <label for="AddressProvinceNew">{{ 'customer.addresses.province' | t }}</label>
            <div class="select">
              <select
                id="AddressProvinceNew"
                name="address[province]"
                data-default="{{ form.province }}"
                autocomplete="address-level1"
              ></select>
              <svg aria-hidden="true" focusable="false" viewBox="0 0 10 6">
                <use href="#icon-caret" />
              </svg>
            </div>
          </div>
          <div class="field o_customers__input-field">
            <input
              type="text"
              id="AddressCityNew"
              name="address[city]"
              value="{{ form.city }}"
              autocomplete="address-level2"
              placeholder="{{ 'customer.addresses.city' | t }}"
            >
            <label for="AddressCityNew">{{ 'customer.addresses.city' | t }}</label>
          </div>
          <div class="field o_customers__input-field">
            <input
              type="text"
              id="AddressAddress1New"
              name="address[address1]"
              value="{{ form.address1 }}"
              autocomplete="address-line1"
              placeholder="{{ 'customer.addresses.address1' | t }}"
            >
            <label for="AddressAddress1New">{{ 'customer.addresses.address1' | t }}</label>
          </div>
          <div class="field o_customers__input-field">
            <input
              type="text"
              id="AddressAddress2New"
              name="address[address2]"
              value="{{ form.address2 }}"
              autocomplete="address-line2"
              placeholder="{{ 'customer.addresses.address2' | t }}"
            >
            <label for="AddressAddress2New">{{ 'customer.addresses.address2' | t }}</label>
          </div>
          
          
          
          
          <div class="field o_customers__input-field">
            <input
              type="tel"
              id="AddressPhoneNew"
              name="address[phone]"
              value="{{ form.phone }}"
              autocomplete="tel"
              placeholder="{{ 'customer.addresses.phone' | t }}"
            >
            <label for="AddressPhoneNew">{{ 'customer.addresses.phone' | t }}</label>
          </div>
          <div class="u_hide">
            <label for="AddressCountryNew">{{ 'customer.addresses.country' | t }}</label>
            <div class="select">
              <select
                id="AddressCountryNew"
                name="address[country]"
                data-default="Japan"
                autocomplete="country"
