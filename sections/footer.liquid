{% if request.path == '/collections/point_item' %}
<script>
(async () => {
  const page = window.location.pathname;
  const navEntries = performance.getEntriesByType("navigation");
  const navType = navEntries.length > 0 ? navEntries[0].type : performance.navigation.type;
  const referrer = document.referrer;

  let intervalId = null;
  let checking = false;
  let errorCount = 0;

  // セッションIDの生成（タブごとに異なる）
  let sessionId = sessionStorage.getItem("view-session");
  if (!sessionId) {
    sessionId = crypto.randomUUID();
    sessionStorage.setItem("view-session", sessionId);
  }

  const userId = {{ customer.id | json }};
  if (!userId) return;

  // ✅ 初回セッション登録
  await checkAccess(true);

  // 🚫 ブックマーク直打ち or F5 対策
  if (navType === "navigate" && referrer === "") {
    alert("このページは直接開けません。");
    return;
  }
  if (navType === "reload") {
    alert("このページは再読み込みできません。");
    return;
  }

  // 🔁 15秒ごとのチェック（旧: 7秒 → 軽量化）
  intervalId = setInterval(() => {
    if (document.visibilityState === "visible") {
      checkAccess(false);
    }
  }, 5000);

  // ⏱️ 5分後にセッションタイムアウト（軽量ページなら妥当）
  setTimeout(() => {
    if (intervalId) clearInterval(intervalId);
    alert("申し訳ございません。セッションタイムアウトです。再度アクセスをお願いします。");
    window.location.href = "/";
  }, 5 * 60 * 1000); // ← 任意で調整OK

  // 🔁 タブ復帰時に即チェック
  document.addEventListener("visibilitychange", () => {
    if (document.visibilityState === "visible") {
      checkAccess(false);
    }
  });

  // 🚀 セッションチェック関数（Cloud Functions）
  async function checkAccess(isInit) {
    if (checking) return;
    checking = true;

    try {
      const res = await fetch("https://us-central1-test-pt-2ce26.cloudfunctions.net/checkAndUpdateSession", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({
          user_id: userId,
          session_id: sessionId,
          page: page,
          isInit: isInit
        }),
      });

      const result = await res.json();

      if (!result.allowed) {
        alert("このページは他のブラウザ／タブで閲覧中です。申し訳ございませんが同時にアクセスは行えません。");
        if (intervalId) clearInterval(intervalId);
        window.location.href = "/";
      } else {
        errorCount = 0; // 成功したらエラーカウントリセット
      }

    } catch (e) {
      console.error("通信エラー:", e);
      errorCount++;
      if (errorCount >= 5) {
        clearInterval(intervalId);
        alert("ページを再読み込みしてください。");
        window.location.href = "/";
      }
    } finally {
      setTimeout(() => { checking = false; }, 3000); // 通信中フラグの制御
    }
  }
})();
</script>
{% endif %}


        {% if request.path == '/collections/point_item' %}
<script>
document.addEventListener("DOMContentLoaded", async () => {
  const userId = {{ customer.id | json }};
  if (!userId) return;

  const buttons = document.querySelectorAll("button[data-variant-id]");

function disableButton(button, label = "少しお待ちください") {
  // すでに在庫切れならテキストを変更しない
  if (button.dataset.soldout === "true") {
    button.disabled = true;
    button.style.opacity = "0.5";
    button.textContent = "在庫切れ";
    return;
  }
  button.disabled = true;
  button.style.opacity = "0.5";
  button.textContent = label;
}

function enableButton(button) {
  // 在庫切れボタンは「交換する」に戻さない
  if (button.dataset.soldout === "true") {
    button.disabled = true;
    button.style.opacity = "0.5";
    button.textContent = "在庫切れ";
    return;
  }
  button.disabled = false;
  button.style.opacity = "";
  button.textContent = "交換する";
}

  async function fetchCooldowns() {
    try {
      const res = await fetch(`https://us-central1-test-pt-2ce26.cloudfunctions.net/getCooldowns?user_id=${userId}`);
      return await res.json();
    } catch (e) {
      console.error("クールタイム取得失敗:", e);
      return {};
    }
  }
async function applyCooldowns() {
  const now = Math.floor(Date.now() / 1000);
  const storedUntil = parseInt(localStorage.getItem('cooldown_until'), 10);

  if (!isNaN(storedUntil) && storedUntil > now) {
    const remaining = storedUntil - now;
    buttons.forEach(button => {
      disableButton(button, `少しお待ちください（${remaining}）`);
    });
    return;
  }

  const cooldowns = await fetchCooldowns();
  const isAnyCooldown = Object.keys(cooldowns).length > 0;

  if (isAnyCooldown) {
    // クールダウンをローカルに60秒設定（別ブラウザ対応）
    const simulatedUntil = now + 60;
    localStorage.setItem('cooldown_until', simulatedUntil);

    const remaining = 60;
    buttons.forEach(button => {
      disableButton(button, `少しお待ちください（${remaining}）`);
    });

    // 以後のカウントダウンは setInterval 側で自動更新
  } else {
    buttons.forEach(button => {
      enableButton(button);
    });
  }
}


  async function handleClick(button, productId) {
    try {
      const res = await fetch("https://us-central1-test-pt-2ce26.cloudfunctions.net/handleExchange", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ user_id: userId, product_id: productId }),
      });

      const result = await res.json();

      // ✅ 常に全ボタンを一時的に無効化
      const cooldownDuration = 60;
      const until = Math.floor(Date.now() / 1000) + cooldownDuration;
      localStorage.setItem('cooldown_until', until);

      buttons.forEach(btn => disableButton(btn, `少しお待ちください（${cooldownDuration}）`));

      if (!result.allowed) {
        alert("しばらくお待ちください。");
        return;
      }

      // ✅ 成功時も applyCooldowns は任意で遅延呼び出ししておく（なくてもOK）
      setTimeout(() => {
        applyCooldowns();
      }, 60000);

    } catch (e) {
      console.error("交換処理エラー:", e);
    }
  }

  // ボタンクリックにイベントを登録
  buttons.forEach(button => {
    const productId = button.dataset.variantId;
    if (!productId) return;
    button.addEventListener("click", () => handleClick(button, productId));
  });

  // ✅ 初回チェック
  await applyCooldowns();

  // 🔁 1秒おきに残り時間更新
  let intervalId = setInterval(() => {
    if (document.visibilityState === "visible") {
      applyCooldowns();
    }
  }, 1000);

  // ✅ ページがフォーカスされた時に再チェック
  window.addEventListener("focus", applyCooldowns);
});
</script>
{% endif %}


