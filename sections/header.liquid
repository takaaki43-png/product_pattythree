{%- liquid
  for block in section.blocks
    if block.type == '@app'
      assign has_app_block = true
    endif
  endfor
-%}

<{% if section.settings.sticky_header_type != 'none' %}sticky-header data-sticky-type="{{ section.settings.sticky_header_type }}"{% else %}div{% endif %} class="header-wrapper gradient{% if section.settings.show_line_separator %} header-wrapper--border-bottom{% endif %}">
  <header class="header l_header {% if section.settings.menu_type_desktop == 'drawer' %} drawer-menu{% endif %}{% if section.settings.menu != blank %} header--has-menu{% endif %}{% if has_app_block %} header--has-app{% endif %}">
    <div class="l_header__top">
      {%- if request.page_type == 'index' -%}
        <h1 class="header__heading">
      {%- endif -%}
          <a href="https://staging.pattythree-shop.jp/" class="header__heading-link link link--text focus-inset">
            <div class="header__heading-logo-wrapper">
              <img src="{{ 'pattythree_logo.svg' | asset_url }}" alt="{{shop.name}}" loading="eager" class="header__heading-logo motion-reduce">
            </div>
          </a>
      {%- if request.page_type == 'index' -%}
        </h1>
      {%- endif -%}
     {%- if shop.customer_accounts_enabled -%}
         <a href="{%- if customer -%}{{ routes.account_url }}{%- else -%}{{ routes.account_login_url }}{%- endif -%}" class="header__icon header__icon--account link focus-inset">
           <span class="btn-login--icon">
              <svg version="1.1" id="svg-login" xmlns="http://www.w3.org/2000/svg" xmlns:xlink="http://www.w3.org/1999/xlink" x="0px" y="0px" width="10px" height="14px" viewBox="0 0 10 14" style="enable-background:new 0 0 10 14;" xml:space="preserve">
                <path d="M4.5-0.3c1.7,0,3.2,1.4,3.2,3.2S6.2,6,4.5,6S1.3,4.6,1.3,2.8C1.3,1.1,2.8-0.3,4.5-0.3z M4.5,4.9c1.1,0,2.1-0.9,2.1-2.1c0-1.1-0.9-2.1-2.1-2.1c-1.1,0-2.1,0.9-2.1,2.1C2.4,4,3.4,4.9,4.5,4.9z"></path>
