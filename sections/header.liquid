  <script>
  (() => {
    const sh_menu = document.querySelector('[data-sh-menu]');
    const sh_toggleButton = document.querySelector('[data-sh-menu-toggle]');
    const sh_menuPanel = document.querySelector('[data-sh-menu-panel]');
    const sh_menuContent = document.querySelector('[data-sh-menu-content]');
    const sh_backdrop = document.querySelector('[data-sh-menu-backdrop]');
    let sh_scrollPosition = 0;

    if (
      !sh_menu ||
      !sh_toggleButton ||
      !sh_menuPanel ||
      !sh_menuContent ||
      !sh_backdrop
    ) {
      return;
    }

    const sh_setMenuState = (sh_isOpen) => {
      sh_menu.classList.toggle('sh_is-open', sh_isOpen);
      sh_toggleButton.classList.toggle('sh_is-open', sh_isOpen);
      sh_toggleButton.classList.remove('sh_is-scrolled');

      sh_toggleButton.setAttribute('aria-expanded', String(sh_isOpen));
      sh_toggleButton.setAttribute(
        'aria-label',
        sh_isOpen ? 'メニューを閉じる' : 'メニューを開く'
      );

      sh_menuPanel.setAttribute('aria-modal', String(sh_isOpen));
      sh_menuContent.setAttribute('aria-hidden', String(!sh_isOpen));

      if (sh_isOpen) {
        sh_menuPanel.scrollTop = 0;
        sh_scrollPosition = window.scrollY;

        document.body.classList.add('sh_is-locked');
        document.body.style.top = `-${sh_scrollPosition}px`;
        return;
      }

      document.body.classList.remove('sh_is-locked');
      document.body.style.top = '';
      window.scrollTo(0, sh_scrollPosition);
    };

    sh_toggleButton.addEventListener('click', () => {
      sh_setMenuState(!sh_menu.classList.contains('sh_is-open'));
    });

    sh_menu.addEventListener('click', (sh_event) => {
      if (
        sh_event.target === sh_menu ||
        sh_event.target === sh_backdrop
      ) {
        sh_setMenuState(false);
      }
    });

    document.addEventListener('keydown', (sh_event) => {
      if (
        sh_event.key === 'Escape' &&
        sh_menu.classList.contains('sh_is-open')
      ) {
        sh_setMenuState(false);
      }
    });

    sh_menu.querySelectorAll('a').forEach((sh_link) => {
      sh_link.addEventListener('click', () => {
        sh_setMenuState(false);
      });
    });

    sh_menuPanel.addEventListener('scroll', () => {
      if (!sh_menu.classList.contains('sh_is-open')) return;

      sh_toggleButton.classList.toggle(
        'sh_is-scrolled',
        sh_menuPanel.scrollTop > 8
      );
    });
  })();
</script>
