                  echo 'customer.account_fallback' | t
                else
                  echo 'customer.log_in' | t
                endif
              -%}
            </span>
        </a>
     {%- endif -%}
        <div class="btn-itunui">
            <a href="https://pattythree-shop-product.jp/collections/itsunui"><span class="sh_itsunui" aria-label="いつぬい">
