<div class="page-width">
  <div class="m_faq__title">{{ section.settings.title }}</div>
  <div class="m_faq__topics">
    {% for block in section.blocks %}
      <div class="m_faq__topic js-faq">
        <div class="m_faq__question js-faq-toggle">
          <div class="m_faq__question__icon">{% render 'icon-caret'%}</div>
          <div class="m_faq__question__q">Q.</div>
          <div class="m_faq__question__heading">{{ block.settings.heading }}</div>
        </div>
        <div class="m_faq__answer js-faq-accordion">
          <div class="m_faq__answer__inner">
            <div class="m_faq__answer__inner__a">A.</div>
            <div class="m_faq__answer__inner__content">
            {% if block.settings.custom_html_v2 != blank %}
              {{ block.settings.custom_html_v2 | raw }}
            {% else %}
              {{ block.settings.answer }}
            {% endif %}
           </div>
          </div>
        </div>
      </div>
    {% endfor %}
  </div>
</div>

{%- javascript -%}
  window.addEventListener('load', () => {
    const target = document.querySelectorAll('.js-faq-toggle');
    target.forEach((v) => {
      v.addEventListener('click', (e) => {
        e.currentTarget.classList.toggle('is-open'); 
        e.currentTarget.nextElementSibling.classList.toggle('is-open'); 
        if (e.currentTarget.nextElementSibling.classList.contains('is-open')) {
          e.currentTarget.nextElementSibling.style.height = e.currentTarget.nextElementSibling.scrollHeight + 'px';
        } else {
          e.currentTarget.nextElementSibling.style.height = '0';
        }
      });
    });
  });
{%- endjavascript -%}

{%- style -%}
  .section+.section.m_faq {
    margin-top: 60px;
  }
  .m_faq__question.is-open .m_faq__question__icon svg {
    transform: rotate(360deg);
  }
  .m_faq__title {
    background: #FFDC00;
    text-align: left;
    font-size: 20px;
    padding: 18px;
    line-height: 1;
    border-radius: 5px;
    margin-bottom: 50px;
  }
  .m_faq__question {
    cursor: pointer;
  }
  .m_faq__topic:first-of-type {
    margin: 0;
  }
  .m_faq__topic:nth-of-type(n+2) {
    margin-top: 50px;
  }
  .m_faq__answer {
    height: 0;
    overflow: hidden;
    transition:all 0.5s;
  }
  .m_faq__answer__inner {
    padding-left: 32px;
  }
  .m_faq__answer__inner__content ul {
    padding-left: 20px;
  }
  .m_faq__answer__inner__content strong {
    color: red;
  }
  @media screen and (max-width: 749px) {
    .m_faq__title {
      margin-bottom: 25px;
    }
    .m_faq__topic:nth-of-type(n+2) {
      margin-top: 25px;
    }
  }
{%- endstyle -%}

{% schema %}
{
  "name":"よくある質問セクション",
  "class":"l_section--faq section l_section m_faq",
  "tag":"section",
  "settings":[
    {
      "type":"text",
      "id":"classes",
      "label":"クラス"
    },
    {
      "type":"text",
      "id":"title",
      "label":"セクションタイトル"
    }
  ],
  "blocks":[
    {
      "type":"faq",
      "name":"質問-答え",
      "settings":[
        {
          "type":"text",
          "id":"heading",
          "label":"質問"
        },
        {
          "type":"richtext",
          "id":"answer",
          "label":"回答"
        },
        {
          "type": "textarea",
          "id": "custom_html_v2",
          "label": "カスタムHTML（オプション）"
        }
      ]
    }
  ],
  "presets":[
    {
      "name":"よくある質問セクション",
      "blocks":[
        {
          "type":"faq",
          "settings":{
            "heading":"質問1",
            "answer":"<p>回答1</p>"
          }
        }
      ]
    }
  ]
}
{% endschema %}