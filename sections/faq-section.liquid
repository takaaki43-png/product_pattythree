<div class="page-width">
  <div class="m_faq__title">{{ section.settings.title }}</div>
  <div class="m_faq__topics">
    {% for block in section.blocks %}
      <div class="m_faq__topic js-faq">
        <div class="m_faq__question js-faq-toggle">
          <div class="m_faq__question__icon">{% render 'icon-caret'%}</div>
          <div class="m_faq__question__q">Q.</div>
          <div class="m_faq__question__heading">{{ block.settings.heading }}</div>
        </div>
        <div class="m_faq__answer js-faq-accordion">
          <div class="m_faq__answer__inner">
            <div class="m_faq__answer__inner__a">A.</div>
            <div class="m_faq__answer__inner__content">
            {% if block.settings.custom_html_v2 != blank %}
              {{ block.settings.custom_html_v2 | raw }}
            {% else %}
              {{ block.settings.answer }}
            {% endif %}
           </div>
          </div>
        </div>
      </div>
    {% endfor %}
  </div>
</div>

{%- javascript -%}
  (() => {
    const openFaq = (toggle) => {
      const answer = toggle.nextElementSibling;
      toggle.classList.add('is-open');
      answer.classList.add('is-open');
      answer.style.height = answer.scrollHeight + 'px';
    };

    const closeFaq = (toggle) => {
      const answer = toggle.nextElementSibling;
      toggle.classList.remove('is-open');
      answer.classList.remove('is-open');
      answer.style.height = '0';
    };

    const openFromHash = () => {
      const hash = decodeURIComponent(location.hash.slice(1));
      if (!hash) return;

      const topic = document.getElementById(hash);
      if (!topic || !topic.classList.contains('js-faq')) return;

      const toggle = topic.querySelector('.js-faq-toggle');
      if (!toggle) return;

      openFaq(toggle);
      topic.scrollIntoView({ behavior: 'smooth', block: 'start' });
    };

    window.addEventListener('load', () => {
      document.querySelectorAll('.js-faq-toggle').forEach((toggle) => {
        toggle.addEventListener('click', () => {
          toggle.classList.contains('is-open') ? closeFaq(toggle) : openFaq(toggle);
        });
      });

      openFromHash();
    });

    window.addEventListener('hashchange', openFromHash);
  })();
{%- endjavascript -%}

{%- style -%}
  .section+.section.m_faq {
    margin-top: 60px;
  }
  .m_faq__question.is-open .m_faq__question__icon svg {
    transform: rotate(90deg);
  }
  .m_faq__title {
    background: #FFDC00;
    text-align: left;
    font-size: 20px;
    padding: 18px;
    line-height: 1;
    border-radius: 5px;
    margin-bottom: 50px;
  }
  .m_faq__question {
    cursor: pointer;
  }
  .m_faq__topic:first-of-type {
    margin: 0;
  }
  .m_faq__topic:nth-of-type(n+2) {
    margin-top: 50px;
  }
  .m_faq__answer {
    height: 0;
    overflow: hidden;
    transition:all 0.5s;
  }
  .m_faq__answer__inner {
    padding-left: 32px;
  }
  .m_faq__answer__inner__content ul {
    padding-left: 20px;
  }
  .m_faq__answer__inner__content strong {
    color: red;
  }
  @media screen and (max-width: 749px) {
    .m_faq__title {
      margin-bottom: 25px;
    }
    .m_faq__topic:nth-of-type(n+2) {
      margin-top: 25px;
    }
  }
{%- endstyle -%}

{% schema %}
{
  "name":"よくある質問セクション",
  "class":"l_section--faq section l_section m_faq",
  "tag":"section",
  "settings":[
    {
      "type":"text",
      "id":"classes",
      "label":"クラス"
    },
    {
      "type":"text",
      "id":"title",
      "label":"セクションタイトル"
    }
  ],
  "blocks":[
    {
      "type":"faq",
      "name":"質問-答え",
      "settings":[
        {
          "type":"text",
          "id":"heading",
          "label":"質問"
        },
        {
          "type":"richtext",
          "id":"answer",
          "label":"回答"
        },
        {
          "type": "textarea",
          "id": "custom_html_v2",
          "label": "カスタムHTML（オプション）"
        }
      ]
    }
  ],
  "presets":[
    {
      "name":"よくある質問セクション",
      "blocks":[
        {
          "type":"faq",
          "settings":{
            "heading":"質問1",
            "answer":"<p>回答1</p>"
          }
        }
      ]
    }
  ]
}
{% endschema %}