{{ 'customer.css' | asset_url | stylesheet_tag }}

{%- style -%}
  .o_customers{
    --icon-account: url(data:image/svg+xml;base64,);
  }
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }
  .button-coupon {
    border-radius: 21px;
  }
  .button-coupon img{
    display: block;
    width: 100%;
    max-width: 62px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
.ar_b{
  display: flex;
  flex-wrap: wrap;
  font-size: 14px;
}

.ar_b dt {
  flex-basis: 6%;
  font-weight: bold;
}

.ar_b dd {
  flex-basis: 94%;
  margin:0px;
  word-break: keep-all;
}
.ar_b dd b{
font-weight:bold;
}
   .zendesk-history {
    max-width: 960px;
  }

  .zendesk-history__heading {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 16px;
    padding-bottom: 18px;
    border-bottom: 1px solid #dedede;
  }

  .zendesk-history__count {
    margin: 0;
    color: #777;
    font-size: 14px;
    white-space: nowrap;
  }

  .zendesk-history__list {
    display: grid;
    gap: 12px;
    margin-top: 24px;
  }

  .zendesk-history__loading {
    margin: 0;
    padding: 32px 16px;
    color: #777;
    text-align: center;
  }

  .ticket-card {
    overflow: hidden;
    border: 1px solid #e2e2e2;
    border-radius: 10px;
    background: #fff;
    transition: border-color 0.2s ease, box-shadow 0.2s ease;
    margin-bottom:20px;
  }

  .ticket-card[open] {
    border-color: #222;
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.08);
  }

  .ticket-card__summary {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 20px;
    align-items: center;
    padding: 18px 52px 18px 20px;
    cursor: pointer;
    list-style: none;
  }

  .ticket-card__summary::-webkit-details-marker {
    display: none;
  }

  .ticket-card__summary::after {
    position: absolute;
    top: 50%;
    right: 23px;
    width: 8px;
    height: 8px;
    border-right: 2px solid #222;
    border-bottom: 2px solid #222;
    content: "";
    transform: translateY(-65%) rotate(45deg);
    transition: transform 0.2s ease;
  }

  .ticket-card[open] .ticket-card__summary::after {
    transform: translateY(-35%) rotate(225deg);
  }

  .ticket-card__summary:hover {
    background: #fafafa;
  }

  .ticket-card__number {
    display: block;
    margin-bottom: 5px;
    color: #888;
    font-size: 11px;
  }

  .ticket-card__subject {
    display: block;
    color: #222;
    font-size: 16px;
    font-weight: 700;
    line-height: 1.6;
  }

  .ticket-card__summary-meta {
    display: flex;
    align-items: center;
    gap: 12px;
    color: #777;
    font-size: 12px;
    white-space: nowrap;
  }

  .ticket-card__status {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 66px;
    padding: 5px 9px;
    border-radius: 99px;
    font-size: 11px;
    font-weight: 700;
  }

  .ticket-card__status.is-new {
    color: #075f9d;
    background: #e6f4ff;
  }

  .ticket-card__status.is-open {
    color: #a45500;
    background: #fff0dc;
  }

  .ticket-card__status.is-pending,
  .ticket-card__status.is-hold {
    color: #755300;
    background: #fff8d8;
  }

  .ticket-card__status.is-solved,
  .ticket-card__status.is-closed {
    color: #34714a;
    background: #e7f6eb;
  }

  .ticket-card__status.is-default {
    color: #555;
    background: #f1f1f1;
  }

  .ticket-card__body {
    padding: 20px;
    border-top: 1px solid #ededed;
    background: #fafafa;
  }

  .ticket-card__info {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 12px;
    margin: 0;
  }

  .ticket-card__info > div {
    padding: 12px 14px;
    border-radius: 6px;
    background: #fff;
  }

  .ticket-card__info dt {
    margin-bottom: 4px;
    color: #888;
    font-size: 11px;
  }

  .ticket-card__info dd {
    margin: 0;
    color: #333;
    font-size: 14px;
    font-weight: 700;
  }

  .ticket-card__message {
    margin-top: 16px;
    padding: 16px;
    border-left: 3px solid #222;
    background: #fff;
  }

  .ticket-card__message-title {
    margin: 0 0 8px;
    color: #777;
    font-size: 12px;
    font-weight: 700;
  }

  .ticket-card__description {
    color: #333;
    font-size: 14px;
    line-height: 1.9;
    overflow-wrap: anywhere;
  }
.ticket-card__comments {
  display: grid;
  gap: 12px;
  margin-top: 16px;
}

.ticket-comment {
  padding: 14px 16px;
  border-radius: 8px;
  font-size: 14px;
  line-height: 1.8;
}

.ticket-comment--customer {
  border: 1px solid #ddd;
  background: #fff;
}

.ticket-comment--staff {
  border-left: 3px solid #222;
  background: #f3f3f3;
}

.ticket-comment__meta {
  display: flex;
  justify-content: space-between;
  gap: 16px;
  margin-bottom: 8px;
  color: #777;
  font-size: 12px;
}

.ticket-comment__meta span {
  color: #222;
  font-weight: 700;
}

.ticket-comment__body {
  overflow-wrap: anywhere;
}
  @media (max-width: 767px) {
    .zendesk-history__heading {
      align-items: flex-start;
      flex-direction: column;
      gap: 6px;
    }

    .ticket-card__summary {
      display: block;
      padding: 16px 48px 16px 16px;
    }

    .ticket-card__summary-meta {
      margin-top: 10px;
    }

    .ticket-card__body {
      padding: 16px;
    }

    .ticket-card__info {
      grid-template-columns: 1fr;
    }
  }
{%- endstyle -%}

