<script>
 document.addEventListener('DOMContentLoaded', () => {
  // page toggler
  const targetParameter = 'pages';
  const currentPage = new URLSearchParams(window.location.search).get(targetParameter);

  const pageElements = {
    main: document.getElementById('page-main'),
    order: document.getElementById('page-orders'),
    p_history: document.getElementById('page-p_history'),
    zendesk: document.getElementById('page-zendesk'),
    coupon: document.getElementById('page-coupon'),
  };

  // すべて非表示にする
  Object.values(pageElements).forEach((element) => {
    element?.classList.add('u_hide');
  });

  // pages=zendesk など、指定ページだけ表示
  // パラメータなし・不正値の場合はmainを表示
  const pageName = pageElements[currentPage] ? currentPage : 'main';
  pageElements[pageName]?.classList.remove('u_hide');

  // order toggler
  const toggleOrder = document.getElementsByClassName('js-order-toggler');
  const toggledOrderBtns = toggleOrder[0].getElementsByClassName(
    'o_customers__order-toggler__button'
  );

  [...toggledOrderBtns].map((btn) => {
    btn.addEventListener('click', (e) => {
      const target = e.currentTarget.dataset.target;
      const toggledOrder = document.getElementsByClassName(target)[0];

      [...toggledOrderBtns].map((button) => {
        button.classList.remove('is-active');
      });

      [...document.getElementsByClassName('js-toggled-order')].map((div) => {
        div.classList.remove('is-active');
      });

      toggledOrder.classList.add('is-active');
      e.currentTarget.classList.add('is-active');
    });
  });
});
</script>

