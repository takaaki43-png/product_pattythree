<div id="page-zendesk" class="u_hide">
<h1 class="o_customers__title">お問い合わせ履歴</h1>
  <div id="zendesk-tickets">読み込み中...</div>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const currentPage = new URLSearchParams(window.location.search).get('pages');

    if (currentPage !== 'zendesk') return;

    const ticketsEl = document.getElementById('zendesk-tickets');

    if (!ticketsEl) return;

    const escapeHTML = (value) =>
      String(value ?? '').replace(/[&<>"']/g, (character) => {
        const entities = {
          '&': '&amp;',
          '<': '&lt;',
          '>': '&gt;',
          '"': '&quot;',
          "'": '&#039;',
        };

        return entities[character];
      });

    const formatText = (value) => {
      const cleaned = String(value ?? '')
        .replace(/&nbsp;|&#160;|&#xA0;|\u00A0/gi, '')
        .replace(/\r\n?/g, '\n')
        .replace(/\n[ \t]*\n[ \t]*\n+/g, '\n\n')
        .trim();

      return escapeHTML(cleaned || '本文はありません。').replace(/\n/g, '<br>');
    };

    const getStatus = (value) => {
      const statuses = {
        new: { label: '新規', className: 'is-new' },
        open: { label: '対応中', className: 'is-open' },
        pending: { label: '確認待ち', className: 'is-pending' },
        hold: { label: '保留', className: 'is-hold' },
        solved: { label: '解決済み', className: 'is-solved' },
        closed: { label: 'クローズ', className: 'is-closed' },
      };

      return statuses[String(value || '').toLowerCase()] || {
        label: value || '不明',
        className: 'is-default',
      };
    };

    const formatDate = (value) => {
      if (!value) return '—';

      const date = new Date(value);

      if (Number.isNaN(date.getTime())) return value;

      return date.toLocaleString('ja-JP', {
        year: 'numeric',
        month: '2-digit',
        day: '2-digit',
        hour: '2-digit',
        minute: '2-digit',
        hour12: false,
        timeZone: 'Asia/Tokyo',
      });
    };

    fetch('/apps/zendesk', {
      method: 'POST',
      headers: {
        'Content-Type': 'application/json',
      },
      body: JSON.stringify({
        email: {{ customer.email | json }},
      }),
    })
      .then(async (res) => {
        const data = await res.json();

        if (!res.ok || data.error) {
          throw new Error(data.error || 'Zendeskの取得に失敗しました。');
        }

        return data;
      })
      .then((data) => {
        const tickets = Array.isArray(data.tickets) ? data.tickets : [];

        if (tickets.length === 0) {
          ticketsEl.innerHTML = '<p>お問い合わせ履歴はありません。</p>';
          return;
        }

        ticketsEl.innerHTML = tickets
          .map((ticket) => {
            const comments = Array.isArray(ticket.comments)
              ? ticket.comments
              : [];

            const status = getStatus(ticket.status);

            return `
              <details class="ticket-card">
                <summary class="ticket-card__summary">
                  <span class="ticket-card__subject">
                    ${escapeHTML(ticket.subject || '件名なし')}
                  </span>

                  <span class="ticket-card__meta">
                    <span class="ticket-card__status ${status.className}">
                      ${escapeHTML(status.label)}
                    </span>
                    <time>${escapeHTML(formatDate(ticket.updated_at))}</time>
                  </span>
                </summary>

                <div class="ticket-card__body">
                  <p>お問い合わせ番号：${escapeHTML(ticket.id)}</p>

                  <div class="ticket-card__comments">
                    ${
                      comments.length
                        ? comments
                            .map((comment) => {
                              const isStaff = comment.author_type === 'staff';

                              return `
                                <article class="ticket-comment ticket-comment--${
                                  isStaff ? 'staff' : 'customer'
                                }">
                                  <div class="ticket-comment__meta">
                                    <span>
                                      ${
                                        isStaff
                                          ? 'サポート担当'
                                          : 'お客様'
                                      }
                                    </span>
                                    <time>
                                      ${escapeHTML(formatDate(comment.created_at))}
                                    </time>
                                  </div>

                                  <div class="ticket-comment__body">
                                    ${formatText(comment.body)}
                                  </div>
                                </article>
                              `;
                            })
                            .join('')
                        : '<p>公開されている会話履歴はありません。</p>'
                    }
                  </div>
                </div>
              </details>
            `;
          })
          .join('');
      })
      .catch((error) => {
        ticketsEl.innerHTML =
          '<p>お問い合わせ履歴を表示できません。</p>';

        console.error(error);
      });
  });
</script>
 </div>

  <div id="page-coupon" class="u_hide">
      <h1 class="o_customers__title">取得クーポン</h1>
        {% assign now = 'now' | date: "%s" %}
      {% assign has_valid_coupon = false %}
      
      {% assign sorted_coupons = shop.metaobjects.mypage_coupon.values | sort: "open_data.value" %}

      {% for coupon in sorted_coupons %}
        {% assign display = coupon.display.value %}
        {% assign discount_tag = coupon.discount_tag.value %}
        {% assign hidden_tag = coupon.display_tag_hidden.value %}
        {% assign open_ts = coupon.open_data.value | date: "%s" %}
        {% assign close_ts = coupon.close_data.value | date: "%s" %}
        
        {% if display == true %}
          {% if customer.tags contains discount_tag %}
            {% if now >= open_ts and now <= close_ts %}
              {% unless customer.tags contains hidden_tag %}
                {% assign has_valid_coupon = true %}
                <div class="coupon coupon_card">
                  <div class="coupon_card-text">
                    <div class="coupon_card-title">
                      クーポンコード「{{ coupon.discount_code.value }}」
                    </div>
                    <div class="coupon_card-description">
                      有効期間 {{ coupon.close_data.value | date: "%Y/%m/%d %H:%M" }}迄
                    </div>
                  </div>
                  <a href="/discount/{{ coupon.discount_code.value }}?redirect=/cart" class="coupon_card-button">
                    クーポンを適用
                  </a>
                </div>
              {% endunless %}
            {% endif %}
          {% endif %}
        {% endif %}
      {% endfor %}
      
      {% unless has_valid_coupon %}
        <p>現在取得されているクーポンはありません。</p>
      {% endunless %}

